{
  "manifest_version": 3,
  "name": "Website Tour Guide Pro",
  "version": "3.2.0",
  "description": "High-end onboarding tour for LinkedIn",
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "css": ["tour.css"],
      "run_at": "document_idle"
    }
  ]
}
